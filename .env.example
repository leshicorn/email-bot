# ════════════════════════════════════════════════════════════
#  Email Digest Agent — конфигурация
#  Скопируйте в .env и заполните. Затем: chmod 600 .env
# ════════════════════════════════════════════════════════════

# ── Telegram ─────────────────────────────────────────────────
# Создайте бота: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Ваш chat_id: @userinfobot
TELEGRAM_CHAT_ID=123456789

# ── Gmail ────────────────────────────────────────────────────
GMAIL_ENABLED=true
GMAIL_EMAIL=you@gmail.com
# App Password (не основной пароль):
# myaccount.google.com → Security → 2-Step Verification → App Passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Папка IMAP
GMAIL_IMAP_FOLDER=INBOX
# Имя ящика в дайджесте
GMAIL_DISPLAY_NAME=Gmail

# ── mail.ru ──────────────────────────────────────────────────
MAILRU_ENABLED=true
MAILRU_EMAIL=you@mail.ru
# mail.ru → Настройки → Безопасность → Пароли для внешних приложений
MAILRU_APP_PASSWORD=your-mailru-app-password
MAILRU_IMAP_FOLDER=INBOX
MAILRU_DISPLAY_NAME=mail.ru

# ── Yandex ───────────────────────────────────────────────────
YANDEX_ENABLED=true
YANDEX_EMAIL=you@yandex.ru
# passport.yandex.ru → Безопасность → Пароли приложений
YANDEX_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Имя в дайджесте и РЕАЛЬНАЯ папка IMAP — это разные поля.
# Раньше одно поле работало как оба, и на чужих доменах ящик молча падал.
YANDEX_DISPLAY_NAME=Яндекс
YANDEX_IMAP_FOLDER=INBOX

# Таймаут подключения к IMAP, секунды
IMAP_TIMEOUT=60

# ════════════════════════════════════════════════════════════
#  LLM — по умолчанию OpenRouter с бесплатными моделями
# ════════════════════════════════════════════════════════════
LLM_PROVIDER=openrouter

# Ключ: openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Основная модель. Список бесплатных: openrouter.ai/models?max_price=0
OPENROUTER_MODEL=particle-ai/particle-1:free
# Резервная цепочка: бот идёт по ней, если модель отдала 429/503/битый JSON
# или пустой ответ (reasoning-модели съедают весь max_tokens).
OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free,openrouter/free
OPENROUTER_SITE_URL=https://github.com/leshicorn/email-bot
OPENROUTER_APP_TITLE=Email Digest Bot

# Параметры вызова
LLM_TIMEOUT=90
LLM_ATTEMPTS=3
LLM_TEMPERATURE=0.0
# Писем на один вызов модели
LLM_CHUNK_SIZE=12
# Бюджет ответа; reasoning-моделям нужно 6000+, обычным хватает 4000
LLM_MAX_TOKENS=4000

# ── Другие провайдеры (необязательно) ───────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1
#
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
#
# LLM_PROVIDER=gigachat
# GIGACHAT_CREDENTIALS=<base64 client_id:secret>

# ── GonkaRouter — запасной провайдер (OpenAI-совместимый) ────
# Используется, когда OpenRouter ответил 429/лимитом или модель недоступна.
# Без VPN из РФ может не работать — на VPS проверяйте отдельно.
GONKAROUTER_ENABLED=true
GONKAROUTER_API_BASE=https://api.gonkarouter.io/v1
GONKAROUTER_API_KEY=sk-...
# Лучшая по нашим замерам: быстрая и точная. ВАЖНО: не понимает
# response_format=json_object — бот сам пробует без него, потом с ним.
GONKAROUTER_MODEL=MiniMaxAI/MiniMax-M2.7
GONKAROUTER_FALLBACK_MODELS=zai-org/GLM-5.3-Flash,deepseek-ai/DeepSeek-V4-Flash-0731

# User-Agent: Cloudflare перед GonkaRouter отдаёт 403 (error 1010)
# на python-urllib и дефолтный requests, поэтому UA задаётся явно.
LLM_USER_AGENT=EmailDigestAgent/2.0

# ── Расписание ───────────────────────────────────────────────
DIGEST_HOUR=21
DIGEST_MINUTE=0
TIMEZONE=Europe/Moscow

WEEKLY_DIGEST_ENABLED=true
WEEKLY_DIGEST_WEEKDAY=sun
WEEKLY_DIGEST_HOUR=20
WEEKLY_DIGEST_MINUTE=0

# Не присылать сообщение, когда нечего сообщать
QUIET_WHEN_EMPTY=true
# Сколько дней назад смотреть при первом запуске / после долгого простоя
CATCHUP_MAX_DAYS=7

# ── Фильтрация ───────────────────────────────────────────────
# Отправители, считающиеся рассылками (подстрока в адресе)
SKIP_SENDERS_CONTAINING=noreply,no-reply,newsletter,unsubscribe,marketing,mailer-daemon
MAX_BODY_CHARS=3000
MAX_PROMPT_CHARS=120000
# Вырезать цитаты прошлой переписки и подписи из тела
STRIP_QUOTED_REPLIES=true
# Рассылки только считать, не отправлять в LLM
NEWSLETTER_COUNT_ONLY=true
MAX_ATTACHMENT_NAMES=5

# ── Хранилище и логи ─────────────────────────────────────────
DB_PATH=data/digest.db
# Сколько дней хранить историю дедупа и дайджестов
RETENTION_DAYS=90
LOG_LEVEL=INFO
LOG_FILE=bot.log
HEARTBEAT_PATH=data/heartbeat
LOCK_PATH=data/bot.lock
# Не запускать второй экземпляр (Telegram разрешает только один polling)
SINGLE_INSTANCE=true
# Как часто доотправлять застрявшие сообщения, секунды
OUTBOX_FLUSH_INTERVAL=300
